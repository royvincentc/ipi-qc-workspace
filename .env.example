PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://ipi:change-me@localhost:5432/ipi
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback
GOOGLE_APPLICATION_CREDENTIALS=
ADMIN_EMAIL=
PRIVATE_STORAGE=./private
PYTHON_PATH=python
# New-tab report previews are rendered on demand; DOCX downloads work independently.
# PDF_RENDERER=word uses installed Microsoft Word on Windows.
# PDF_RENDERER=libreoffice uses SOFFICE_PATH on supported hosts (included in Docker).
PDF_RENDERER=word
SOFFICE_PATH=
LAB_TIMEZONE=Asia/Manila
# Development only. Never enable with production credentials or company data.
DEMO_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Per signed-in user, reset at the start of each UTC hour. Shared by all server copies.
AI_CHAT_REQUESTS_PER_HOUR=30
AI_TITLE_REQUESTS_PER_HOUR=30
# Input and output tokens combined, including repeated tool/history processing.
AI_TOKENS_PER_HOUR=200000
