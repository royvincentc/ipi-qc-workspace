{
  "name": "ipi-qc-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx server/migrate.ts",
    "demo": "node scripts/demo.mjs",
    "test:worker": "python -m unittest discover -s worker -p test_*.py",
    "connections:verify": "node scripts/verify-google-connections.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.3.14",
    "@excalidraw/excalidraw": "^0.18.1",
    "@google/genai": "^2.24.0",
    "@tanstack/react-virtual": "^3.14.14",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-draggable": "^4.7.2",
    "react-router-dom": "^7.9.4",
    "tsx": "^4.20.6",
    "vite": "^6.4.1",
    "yjs": "^13.6.33",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "agent-browser": "^0.38.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.19"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "sass": "1.105.1",
    "source-map-js": "1.2.2",
    "shell-quote": "1.12.0"
  }
}
